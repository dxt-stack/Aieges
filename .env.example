# Copy to .env for local development. Never commit real credentials.
AEGIS_WORKSPACE=.
AEGIS_DATA_DIR=./aegis/data
AEGIS_CORS_ORIGINS=http://localhost:8000
# When set, all state-changing API requests require X-Aegis-Key.
AEGIS_API_KEY=
# Required for authentic Stripe webhook verification in deployed environments.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
